<?xml version="1.0" encoding="UTF-8"?>
<!-- Odpowiednik game/plans/kanion_4x4.json w formacie Zwift (fixture testów). -->
<workout_file>
    <author>Wasteland Rider</author>
    <name>Kanion 4x4</name>
    <description>Klasyczne interwały VO2max: 4 razy po 4 minuty mocno (105% FTP) z 3 minutami luzu.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.75"/>
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="180" OnPower="1.05" OffPower="0.55" Cadence="95"/>
        <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45"/>
    </workout>
</workout_file>
