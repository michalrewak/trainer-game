<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture: różne zapisy spotykane w plikach .zwo (wielkość liter, warianty atrybutów, textevent). -->
<workout_file>
    <author>Test</author>
    <name><![CDATA[Warianty & pułapki]]></name>
    <description>Opis z encjami: &lt;mocno&gt; &amp; równo</description>
    <sporttype>bike</sporttype>
    <workout>
        <warmup duration="300" powerlow="0.4" powerhigh="0.7"/>
        <WARMUP DURATION="60" POWER="0.6"/>
        <SteadyState Duration="120.0" Power="0.92" Cadence="100">
            <textevent timeoffset="10" message="Jedziemy"/>
            <TextEvent timeoffset="60" message="Połowa"/>
        </SteadyState>
        <steadystate duration="90" PowerLow="0.70" PowerHigh="0.80"/>
        <SteadyState Duration="60" Power="0.5"/>
        <Ramp Duration="120" PowerLow="0.6" PowerHigh="1.2"/>
        <Ramp Duration="60" PowerLow="0.8" PowerHigh="0.5"/>
        <IntervalsT Repeat="2" OnDuration="30" OffDuration="30" PowerOnLow="1.0" PowerOnHigh="1.2" PowerOffLow="0.5" PowerOffHigh="0.4" Cadence="110" CadenceResting="85"/>
        <intervalst repeat="3" onduration="20" onpower="1.3"/>
        <FreeRide Duration="120" FlatRoad="1" Cadence="90"/>
        <Freeride Duration="60"/>
        <MaxEffort Duration="15"/>
        <SolidState Duration="30" Power="0.6"/>
        <SteadyState Duration="0" Power="0.6"/>
        <Unknown Duration="30"/>
        <textevent timeoffset="5" message="Poza krokiem"/>
        <Cooldown Duration="240" PowerLow="0.3" PowerHigh="0.6"/>
    </workout>
</workout_file>
